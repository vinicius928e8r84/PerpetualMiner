# Copie este arquivo para engine/.env e preencha com seus valores reais.
# NUNCA comite o .env (ele está no .gitignore).

# Chave da API da OpenAI (obrigatória) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ID do Assistant usado para cards em russo (opcional; deixe vazio se não usar RU)
ASSISTANT_ID_RU=
