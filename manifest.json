{
  "manifest_version": 3,
  "name": "PerpetualMiner",
  "version": "5.0",
  "key": "",
  "description": "Minerador de legendas com histórico em tempo real e painel de estudos.",
  "minimum_chrome_version": "110",
  "permissions": [
    "alarms",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "contextMenus",
    "identity"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*",
    "https://generativelanguage.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://*.firebaseapp.com/*"
  ],
  "icons": {
    "16": "veio/icones/icone-16.png",
    "32": "veio/icones/icone-32.png",
    "48": "veio/icones/icone-48.png",
    "128": "veio/icones/icone-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "veio/icones/icone-16.png",
      "32": "veio/icones/icone-32.png",
      "48": "veio/icones/icone-48.png",
      "128": "veio/icones/icone-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/voz/catalogo.js", "lib/voz/texto.js", "lib/idioma.js", "lib/atalhos.js", "veio/componentes.js", "overlay.js", "content.js"],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "painel.html", "bookreader.html",
        "veio/tokens.css", "veio/componentes.css", "overlay.css", "veio/icones/icone.svg", "veio/fontes/*.woff2"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
